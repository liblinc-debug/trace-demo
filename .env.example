# 高德地图 Web 端 Key 和安全密钥
VITE_AMAP_KEY=your_amap_web_key
VITE_AMAP_SECURITY=your_amap_security_code

# 后端监听地址和端口
BACKEND_HOST=0.0.0.0
PORT=4000

# Vite 开发服务器监听地址和端口
VITE_HOST=0.0.0.0
VITE_PORT=5173

# ClickHouse 飞行记录数据源（密码只填写在本地 .env，不要提交）
CLICKHOUSE_HTTP_URL=http://10.252.2.13:8123
CLICKHOUSE_DATABASE=uav_logs
CLICKHOUSE_TABLE=comm_report
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_TIMEOUT_S=8
CLICKHOUSE_MAX_ROWS=500000
